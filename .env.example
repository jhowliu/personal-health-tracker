# === API ===
DB_PATH=/data/pht.sqlite
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:8082

# === Object storage (MinIO/Silo 相容) ===
# Docker API uses http://minio:9000. For a backend started directly on the host, use
# http://127.0.0.1:9090 because Compose maps the S3 API from host port 9090.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=meal-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# The API reaches MinIO through S3_ENDPOINT. Mobile clients need a host they can reach
# to upload through the presigned URL, for example http://192.168.1.10:9000 in development.
S3_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# === AI ===
# Leave empty to disable image recognition and suggestion endpoints safely.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Vercel AI Gateway key used only for TypeSafe AI Jev decisions.
JEV_API_KEY=
JEV_MODEL=typesafe-ai/jev
DAILY_AI_IMAGE_QUOTA=10

# === Third-party auth ===
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
APPLE_CLIENT_ID=com.example.pht
APPLE_TEAM_ID=
APPLE_KEY_ID=

# === Push (Expo) ===
EXPO_ACCESS_TOKEN=
